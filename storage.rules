rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /study-resources/{allPaths=**} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.token.email == 'pramodraj9734@gmail.com'
        && request.resource != null
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow delete: if request.auth != null && request.auth.token.email == 'pramodraj9734@gmail.com';
    }
    match /chat-attachments/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource != null && request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }
  }
}